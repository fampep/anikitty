{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/anime/[slug]",
      "regex": "^/anime/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/anime/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/account/comments/[animeId]",
      "regex": "^/api/account/comments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPanimeId": "nxtPanimeId"
      },
      "namedRegex": "^/api/account/comments/(?<nxtPanimeId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/account/comments/[animeId]/[commentId]",
      "regex": "^/api/account/comments/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPanimeId": "nxtPanimeId",
        "nxtPcommentId": "nxtPcommentId"
      },
      "namedRegex": "^/api/account/comments/(?<nxtPanimeId>[^/]+?)/(?<nxtPcommentId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/account/watch/continue/[animeId]/[episodeId]",
      "regex": "^/api/account/watch/continue/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPanimeId": "nxtPanimeId",
        "nxtPepisodeId": "nxtPepisodeId"
      },
      "namedRegex": "^/api/account/watch/continue/(?<nxtPanimeId>[^/]+?)/(?<nxtPepisodeId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/account/watchlist/[animeId]",
      "regex": "^/api/account/watchlist/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPanimeId": "nxtPanimeId"
      },
      "namedRegex": "^/api/account/watchlist/(?<nxtPanimeId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/anime/[id]",
      "regex": "^/api/anime/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/anime/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/anime/[id]/episodes",
      "regex": "^/api/anime/([^/]+?)/episodes(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/anime/(?<nxtPid>[^/]+?)/episodes(?:/)?$"
    },
    {
      "page": "/api/import/[provider]",
      "regex": "^/api/import/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPprovider": "nxtPprovider"
      },
      "namedRegex": "^/api/import/(?<nxtPprovider>[^/]+?)(?:/)?$"
    },
    {
      "page": "/profile/[username]",
      "regex": "^/profile/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPusername": "nxtPusername"
      },
      "namedRegex": "^/profile/(?<nxtPusername>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/anime/watch",
      "regex": "^/anime/watch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/anime/watch(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}