# AniKitty — copy to .env.local for local development
#   cp .env.example .env.local
#
# Coolify: mark secrets as runtime-only. Only NEXT_PUBLIC_* (and DISCORD_CLIENT_ID)
# need to be available at build time.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/anikitty
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=                          # openssl rand -base64 48  (32+ chars)
KITTY_API_KEY=akitty_…               # KittyAPI key — X-API-Key header (server-only)

# --- Access gating ---
# true / 1 / yes / on = allow new passphrase + Discord/AniList account creation
# unset / false = closed (login still works; UI shows Telegram waitlist)
OPEN_SIGNUPS=true

# --- Admin panel ---
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=                    # openssl rand -base64 48
ADMIN_PANEL_PATH=                    # optional custom path; defaults derived from secrets
NEXT_PUBLIC_ADMIN_PANEL_PATH=        # must match public panel path if customized
ADMIN_KEY=                           # optional claim key

# --- Encryption ---
TOTP_ENCRYPTION_KEY=                 # openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=              # openssl rand -base64 32
DATA_ENCRYPTION_KEY=                 # optional; falls back to TOTP / MESSAGE / JWT

# --- OAuth (optional) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=                # defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/discord/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=       # usually injected from DISCORD_CLIENT_ID at build
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=

# --- Streaming / proxy ---
NEXT_PUBLIC_PROXY_URL=
PROXY_SECRET=
HLS_ALLOWED_HOSTS=                   # comma-separated extra hosts for HLS proxy
NEXT_PUBLIC_KITTY_NODE_PRIMARY=
NEXT_PUBLIC_KITTY_NODE_THIRD=
NEXT_PUBLIC_KITTY_NODE_FOURTH=
NEXT_PUBLIC_KITTY_NODE_FIFTH=
NEXT_PUBLIC_KITTY_NODE_SIXTH=
KITTY_API_BASE=

# --- Integrations ---
KLIPY_API_KEY=                       # GIF search — https://partner.klipy.com
KOFI_PAGE_ID=
KOFI_VERIFICATION_TOKEN=
MONTHLY_DONATION_GOAL_EUR=100
BOT_API_SECRET=                      # Bearer for /api/bot/*
CRON_SECRET=                         # Bearer for /api/cron/*
TVDB_API_KEY=
TMDB_API_KEY=
FANART_TV_API_KEY=
FANART_TV_CLIENT_KEY=
MAL_CLIENT_ID=
ANIKOTO_API_BASE=
ANIKOTO_SEARCH_API=

# --- Email (optional; recovery mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
RESEND_API_KEY=

# --- WebAuthn (optional; defaults from NEXT_PUBLIC_APP_URL) ---
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=AniKitty
WEBAUTHN_ORIGIN=

# --- Public site / analytics ---
NEXT_PUBLIC_SITE_URL=https://anikitty.site
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_DONATION_RAISED_EUR=
NEXT_PUBLIC_DISABLE_DEVTOOL_MD5=
NEXT_PUBLIC_CLICK_AD_SCRIPT_SRC=
CHAT_MESSAGE_TTL_HOURS=2
