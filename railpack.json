{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "exclude": [
    ".open-next",
    ".next",
    "node_modules",
    ".claude",
    "pocketbase",
    "docs",
    "drizzle"
  ],
  "variables": {
    "NODE_ENV": "production",
    "NODE_OPTIONS": "--max-old-space-size=6144",
    "SKIP_NEXT_TYPECHECK": "1",
    "CI": "true"
  },
  "steps": {
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "node scripts/start-with-bot.mjs",
    "variables": {
      "HOSTNAME": "0.0.0.0",
      "NODE_ENV": "production"
    }
  }
}
