{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24"
  },
  "exclude": [
    ".open-next",
    ".next",
    "node_modules",
    ".claude",
    "pocketbase",
    "docs",
    "drizzle"
  ],
  "variables": {
    "NODE_ENV": "production",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "deploy": {
    "startCommand": "npm start",
    "variables": {
      "HOSTNAME": "0.0.0.0",
      "NODE_ENV": "production",
      "PORT": "3000"
    }
  }
}
